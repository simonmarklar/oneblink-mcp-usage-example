# OneBlink MCP demo - client configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# The OneBlink MCP server is HTTP-only and holds NO credentials: THIS CLIENT
# supplies its own OneBlink Developer Key per session, as request headers. These
# values are read here and sent as the X-OneBlink-*-Key headers - never as tool
# arguments, so they never enter the model context or any tool log.

# --- Where the MCP server is listening ---------------------------------------
# Start it in the oneblink-mcp project with: npm run start:http
# (defaults to 127.0.0.1:3000). This is the Streamable HTTP /mcp endpoint.
ONEBLINK_MCP_URL=http://127.0.0.1:3000/mcp

# --- SDK Developer Key (required) --------------------------------------------
# From the OneBlink Console -> Developer Keys. Drives create_form / list_* /
# set_form_* . Sent as X-OneBlink-Access-Key / X-OneBlink-Secret-Key.
ONEBLINK_ACCESS_KEY=
ONEBLINK_SECRET_KEY=

# --- CLI deploy key (OPTIONAL) -----------------------------------------------
# A separate CLI *deploy* key pair used only by the deploy workflows
# (set_form_server_validation source="deploy", deploy_hosted_api). When blank
# the server reuses the SDK pair above. Sent as X-OneBlink-CLI-Access-Key /
# X-OneBlink-CLI-Secret-Key.
ONEBLINK_CLI_ACCESS_KEY=
ONEBLINK_CLI_SECRET_KEY=

# --- Example 2 wiring --------------------------------------------------------
# The server-validation hosted API's scope domain. Must already exist as an API
# Hosting entry in the OneBlink Console (create it there first). Example 2 points
# the form's serverValidation + personalisation at this scope.
ONEBLINK_VALIDATION_API_SCOPE=oneblink-mcp-demo-validation.api.oneblink.io

# Environment the validation API is deployed to (dev | test | prod).
ONEBLINK_VALIDATION_API_ENV=dev

# Optional: pin the environment the forms are created in. When blank the
# examples auto-discover the first environment via list_forms_app_environments.
# ONEBLINK_FORMS_APP_ENVIRONMENT_ID=
